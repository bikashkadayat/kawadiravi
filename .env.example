# KTM Kawadi environment variables
# Copy to `.env.local` for local development. Every value is OPTIONAL — the
# site builds and runs correctly with none of them set.

# Canonical origin. Used for canonical URLs, OG tags, sitemap and JSON-LD.
# Defaults to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://ktmkawadi.bikashkadayat.com.np

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Analytics is skipped entirely when this is empty.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID. Skipped when empty.
NEXT_PUBLIC_CLARITY_ID=

# ── TODO (Bikash): Google Search Console verification ────────────────────────
# 1. https://search.google.com/search-console → Add property →
#      https://ktmkawadi.bikashkadayat.com.np
# 2. Pick the "HTML tag" method. Google shows:
#      <meta name="google-site-verification" content="AbC123..." />
# 3. Paste ONLY the content value below (and into the GitHub Actions env for
#    production — see .github/workflows/deploy.yml).
# 4. Rebuild, deploy, then press Verify in Search Console.
#
# Left empty the meta tag is omitted entirely rather than emitted blank, which
# Search Console reports as a failed verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# NOTE: there is deliberately no Formspree variable.
#
# The M0 plan kept Formspree as an optional fallback for the contact form, but
# the form as built composes a prefilled wa.me link and hands off to WhatsApp —
# it never posts anywhere. That means no backend, no third-party form service,
# and no personal data stored by this site at all, so the fallback would have
# been dead configuration. Add it back only if a real email-delivery path is
# ever needed.
